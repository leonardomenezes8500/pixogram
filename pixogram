#!/bin/sh
# pixogram — figlet-like pixel-art text, mini.nvim logo style: 4x7 blocky
# glyphs, no antialiasing, no font hinting artifacts. Prints ASCII block art
# to stdout, or (with -o) a colored PNG via ImageMagick.
#
# Font shapes are transcribed pixel-for-pixel from nvim-mini/assets
# logo-2/font/*.gif (MIT License, (c) Evgeni Chasnovski) — see README.md.
#
# POSIX sh + awk do all the layout; `magick` is only needed for -o.
set -eu

usage() {
	cat <<'EOF'
usage: pixogram [-o FILE] [-b BG] [-s SCALE] TEXT[:COLOR] ...

  No -o        print ASCII block art to stdout (colors ignored)
  -o FILE      write a PNG instead (needs ImageMagick's `magick`)
  -b COLOR     background color, hex (default #00182A)
  -s SCALE     PNG upscale factor per grid cell (default 15)
  -h           show this help

Each TEXT argument may carry its own :COLOR for -o mode
(default #D9D8AA). Multiple TEXT args are just concatenated — no gap is
inserted, since every glyph already carries its own trailing blank column.
Unsupported characters (only a-z0-9 and space exist) render as a blank cell.

examples:
  pixogram "hello world"
  pixogram -o logo.png "TRACK:#bfe3ff" "EC:#dcd2a0"
EOF
}

