render() {
	# $1 = lowercased text, $2 = mode (grid|text)
	printf '%s' "$AWKPROG" | awk -v text="$1" -v mode="$2" -f -
}

outfile=""
bg="#00182A"
fg_default="#D9D8AA"
scale=15

while getopts "o:b:s:h" opt; do
	case "$opt" in
	o) outfile="$OPTARG" ;;
	b) bg="$OPTARG" ;;
	s) scale="$OPTARG" ;;
	h)
		usage
		exit 0
		;;
	*)
		usage
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] || {
	usage
	exit 1
}

if [ -z "$outfile" ]; then
	words=""
	for seg in "$@"; do
		t="${seg%%:*}"
		words="$words $t"
	done
	text_lower=$(printf '%s' "${words# }" | tr 'A-Z' 'a-z')
	render "$text_lower" text
	exit 0
fi

command -v magick >/dev/null 2>&1 || {
	echo "pixogram: -o needs ImageMagick's 'magick' on PATH" >&2
	exit 1
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

first=true
for seg in "$@"; do
	t="${seg%%:*}"
	case "$seg" in
	*:*) color="${seg#*:}" ;;
	*) color="$fg_default" ;;
	esac
	t_lower=$(printf '%s' "$t" | tr 'A-Z' 'a-z')
	grid=$(render "$t_lower" grid)
	width=$(printf '%s\n' "$grid" | head -n 1 | awk '{ print length }')
	pbm="$tmpdir/seg.pbm"
	{
		printf 'P1\n%s 7\n' "$width"
		printf '%s\n' "$grid"
	} >"$pbm"
	png="$tmpdir/seg.png"
	# -opaque collapses to grayscale on a bilevel-origin image in some
	# ImageMagick builds (loses the fill color); a 2-stop CLUT keeps true RGB.
	magick "$pbm" -colorspace sRGB \( -size 1x2 "gradient:$color-$bg" \) -clut "$png"
	if $first; then
		cp "$png" "$tmpdir/acc.png"
		first=false
	else
		magick "$tmpdir/acc.png" "$png" -background "$bg" +append "$tmpdir/acc_next.png"
		mv "$tmpdir/acc_next.png" "$tmpdir/acc.png"
	fi
done

acc_width=$(magick identify -format '%w' "$tmpdir/acc.png")
# every glyph carries its own trailing blank column, so the right edge already
# has a 1px margin — the left edge doesn't, since nothing precedes the first
# glyph. Pad the canvas 1px on the left only (anchor East) to match.
magick "$tmpdir/acc.png" -gravity East -background "$bg" -extent "$((acc_width + 1))x7" "$tmpdir/acc_padded.png"

magick "$tmpdir/acc_padded.png" -filter point -resize "${scale}00%" "$outfile"
echo "$outfile"
